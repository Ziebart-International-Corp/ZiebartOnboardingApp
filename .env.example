# Copy this to .env and fill in real values. Never commit .env to git.
# This app uses SQL Server only (DATABASE_URL / Neon is not used).

SECRET_KEY=your-secret-key-here

# Database (SQL Server) — required
DB_SERVER=your-server.com
DB_PORT=42278
DB_NAME=NewHireApp
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional
# DB_MAX_POOL_SIZE=300

# Asana feedback — personal access token (or service account token) + project GID.
# Client id/secret are NOT the API token; they are only used for optional OAuth.
ASANA_ACCESS_TOKEN=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Optional OAuth refresh token (alternative to ASANA_ACCESS_TOKEN):
# ASANA_REFRESH_TOKEN=
# ASANA_REDIRECT_URI=https://your-domain.com/admin/asana/callback
# Project GID from the Asana project URL (e.g. .../project/1234567890123456/... → 1234567890123456)
ASANA_FEEDBACK_PROJECT_GID=
# Section (list) GIDs — number at end of .../list/SECTION_GID in Asana when viewing each section
ASANA_SECTION_GID_COMMENT=
ASANA_SECTION_GID_ISSUE=
ASANA_SECTION_GID_SUGGESTION=
# Assignee for new feedback tasks (Asana user GID — Ann Symons / asymons@ziebart.com)
ASANA_FEEDBACK_ASSIGNEE_GID=1206412683918472

# Test Form Wizard (admin quick link) — optional AI for scanned PDFs
# OPENAI_API_KEY=sk-...
# OPENAI_FORM_MODEL=gpt-4o-mini
# OPENAI_FORM_MAX_PAGES=8
