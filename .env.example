# Copy this to .env and fill in real values. Never commit .env to git.
# This app uses SQL Server only (DATABASE_URL / Neon is not used).

SECRET_KEY=your-secret-key-here

# Database (SQL Server) — required
DB_SERVER=your-server.com
DB_PORT=42278
DB_NAME=NewHireApp
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional
# DB_MAX_POOL_SIZE=300

# Asana feedback (OAuth — from developer.asana.com → My apps → your app)
# Client id + secret are NOT the API token. An admin connects once at /admin/asana/feedback.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Register this exact URL under Redirect URL in the Asana app settings:
# ASANA_REDIRECT_URI=https://your-domain.com/admin/asana/callback
# Project GID from the Asana project URL (e.g. .../0/1234567890123456 → 1234567890123456)
ASANA_FEEDBACK_PROJECT_GID=

# Test Form Wizard (admin quick link) — optional AI for scanned PDFs
# OPENAI_API_KEY=sk-...
# OPENAI_FORM_MODEL=gpt-4o-mini
# OPENAI_FORM_MAX_PAGES=8
