<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- FastCGI Configuration -->
    <handlers>
      <add name="Python FastCGI" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Websites\NewHireApp\venv\Scripts\python.exe|C:\Websites\NewHireApp\venv\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <!-- URL Rewrite Rules: send all non-static requests to Flask (including root /) -->
    <rewrite>
      <rules>
        <!-- Redirect HTTP to HTTPS for onboarding domains -->
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^(ziebartonboarding\.com|www\.ziebartonboarding\.com)$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Serve only files under static/ directly; everything else (including uploads/) goes through Flask auth -->
        <rule name="Serve static folder files" stopProcessing="true">
          <match url="^static/.*" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Python FastCGI" stopProcessing="true">
          <match url=".*" ignoreCase="false" />
          <action type="Rewrite" url="app.py/{R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <!-- Environment Variables -->
    <fastCgi>
      <application fullPath="C:\Websites\NewHireApp\venv\Scripts\python.exe" arguments="C:\Websites\NewHireApp\venv\Lib\site-packages\wfastcgi.py" maxInstances="4" idleTimeout="1800" activityTimeout="30" requestTimeout="90" instanceMaxRequests="10000" protocol="NamedPipe" flushNamedPipe="False">
        <environmentVariables>
          <environmentVariable name="PYTHONPATH" value="C:\Websites\NewHireApp" />
          <environmentVariable name="WSGI_HANDLER" value="app.app" />
          <environmentVariable name="WSGI_LOG" value="C:\Websites\NewHireApp\logs\wfastcgi.log" />
        </environmentVariables>
      </application>
    </fastCgi>
    <!-- Default Documents -->
    <defaultDocument>
      <files>
        <clear />
        <add value="app.py" />
      </files>
    </defaultDocument>
    <!-- Block access to .env and other secrets (keys/connection strings stay server-side only) -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.local" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Directory Browsing -->
    <directoryBrowse enabled="false" />
    <!-- HTTP Errors — DetailedLocalOnly avoids leaking stack/config to remote clients -->
    <httpErrors errorMode="DetailedLocalOnly" />
    <!-- Static File Handling -->
    <!-- Note: .json mimeMap is already defined at server level, so we don't add it here -->
    <!-- Windows Authentication -->
    <!-- Pass Windows Auth to Python and Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Forwarded-User" value="{REMOTE_USER}" />
        <add name="X-Remote-User" value="{REMOTE_USER}" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <appSettings>
    <!-- Application Settings -->
    <add key="PYTHONPATH" value="C:\Websites\NewHireApp" />
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="WSGI_LOG" value="C:\Websites\NewHireApp\logs\wfastcgi.log" />
  </appSettings>
</configuration>
